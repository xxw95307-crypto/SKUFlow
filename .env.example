# Platform credentials are intentionally empty on Day 1.
# Never commit real app secrets, access tokens, refresh tokens, or seller credentials.

AMAZON_SP_API_CLIENT_ID=
AMAZON_SP_API_CLIENT_SECRET=
AMAZON_SP_API_REFRESH_TOKEN=
AMAZON_US_SELLER_ID=
AMAZON_SP_API_SANDBOX_CLIENT_ID=
AMAZON_SP_API_SANDBOX_CLIENT_SECRET=
AMAZON_SP_API_SANDBOX_REFRESH_TOKEN=
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
# Shopify Dev Store（官方测试店铺；应用与店铺必须属于同一 Dev Dashboard 组织）
SHOPIFY_DEV_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_DEV_CLIENT_ID=
SHOPIFY_DEV_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# Alibaba Cloud Bailian (server-side only). Use a general Bailian Key with
# the general endpoint. Token Plan requires its own active subscription,
# sk-sp- Key, and token-plan endpoint; do not mix the two credential types.
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen3.8-max
BAILIAN_IMAGE_MODEL=qwen-image-2.0
# Optional separate Key for Wan video generation; defaults to BAILIAN_API_KEY.
BAILIAN_VIDEO_API_KEY=
